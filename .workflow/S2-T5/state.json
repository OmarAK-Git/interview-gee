{
  "goal": "Run session one end-to-end in the isolated profile with exactly three questions and deferred automatic persistence.",
  "success_criteria": [
    "E2E shows deferred automatic persistence.",
    "Session one runs against installed Hermes in the isolated profile.",
    "Exactly three questions; MEMORY.md unchanged until finalize after the third answer.",
    "No persist confirmation prompt."
  ],
  "constraints": [
    "Stay within S2-T5 files_allowed",
    "Task-scoped verification",
    "Never mutate real ~/.hermes",
    "Do not implement candidate staging or session-two opener"
