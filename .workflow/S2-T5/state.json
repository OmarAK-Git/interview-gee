      "ownership": "implementer",
      "status": "done"
    },
    {
      "id": "03-review",
      "objective": "Review code-changing implementation",
      "ownership": "code-reviewer",
      "status": "done"
    },
    {
      "id": "04-verify",
      "objective": "Run task-scoped verification",
      "ownership": "skeptic-verifier",
