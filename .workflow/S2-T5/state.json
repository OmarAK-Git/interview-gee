    {
      "risk": "Hermes memory tool rewrites MEMORY.md before finalize",
      "approval_required": false,
      "mitigation": "Choose disable-memory-tool or harness-only writes; throwaway profile only"
    }
  ],
  "max_concurrent_agents": 2,
  "max_total_agents": 6,
  "packets": [
